# Copy to backend/.env and fill
DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# For local without Neon:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shinygrand

JWT_SECRET=change-me-32-chars-minimum
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_DAYS=7

STATION_TOKEN_EXPIRES_MINUTES=5
ATTENDANCE_THRESHOLD=0.42
ATTENDANCE_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000,https://*.pages.dev

# Face
INSIGHTFACE_MODEL_DIR=./onnx_models
EMBEDDING_DIM=512

# Time
TZ=Asia/Kolkata
